<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Objetos que usa la vista en las expresiones @{} -->
    <data>
        <import type="android.view.View" />
        <import type="es.davante.edadcanina.modelo.Validacion" />

        <variable
            name="modelo"
            type="es.davante.edadcanina.modelo.EdadCaninaModelo" />
    </data>

    <!-- <layout> como raíz activa DataBinding en este fichero: al compilar se genera
         ActivityMainBinding, con un campo por cada vista que tiene id -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".MainActivity">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/txt_titulo"
            android:textSize="32sp" />

        <ImageView
            android:layout_width="192dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:adjustViewBounds="true"
            android:src="@drawable/imgdog" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/input_age"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- @={} enlaza en los dos sentidos: lo que escribe el usuario llega solo al modelo.
             app:errorValidacion es un atributo propio (vista/AdaptadoresVista) que pinta el
             error a partir de la Validacion del modelo -->
        <EditText
            android:id="@+id/age_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:gravity="center"
            android:hint="@string/hint_edad"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="2"
            android:text="@={modelo.edadTexto}"
            android:textSize="48sp"
            app:errorValidacion="@{modelo.validacion}" />

        <!-- El resultado se pinta solo a partir del modelo. INVISIBLE y no GONE: así el
             TextView sigue ocupando su sitio y el botón no salta al aparecer el texto -->
        <TextView
            android:id="@+id/result_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@{@string/tu_edad_format(modelo.edadHumana)}"
            android:textSize="16sp"
            android:visibility="@{modelo.validacion == Validacion.OK ? View.VISIBLE : View.INVISIBLE}" />

        <Button
            android:id="@+id/btn_calc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/btn_calc"
            android:textSize="22sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
